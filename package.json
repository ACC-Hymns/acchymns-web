{
  "name": "acchymnal",
  "version": "5.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "patch-package",
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit",
    "lint": "npx eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-pattern .gitignore",
    "format": "prettier --write src/",
    "deploy-check": "node deployment-checks.mjs",
    "capacitor:copy:after": "node add-on-books-handler.mjs",
    "netlify-build": "npm run deploy-check && npm run build && npm run compress && node ./seo/seo-deployment.mjs && cp dist/index.html dist/404.html && touch dist/.nojekyll",
    "compress": "npx cap copy web"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.554.0",
    "@aws-sdk/credential-providers": "^3.554.0",
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/dialog": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/network": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/screen-orientation": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capacitor/toast": "^8.0.0",
    "@capawesome/capacitor-posthog": "^7.1.0",
    "@ionic/pwa-elements": "^3.3.0",
    "@vueuse/components": "^12.5.0",
    "@vueuse/core": "^12.5.0",
    "axios": "^1.7.9",
    "folder-hash": "^4.0.4",
    "panzoom": "^9.4.3",
    "pdfjs-dist": "^4.10.38",
    "pinia": "^2.3.1",
    "polymorph-js": "^1.0.2",
    "posthog-js": "^1.250.1",
    "tone": "^15.0.4",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.0.0",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^20.17.17",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.7.0",
    "dotenv": "^16.4.7",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "juice": "^11.0.0",
    "node-html-parser": "^7.0.1",
    "patch-package": "^8.0.0",
    "prettier": "^3.4.2",
    "satori": "^0.32.0",
    "satori-html": "^0.3.2",
    "typescript": "~5.9.0",
    "vite": "^8.3.8",
    "vue-tsc": "^3.3.14"
  }
}